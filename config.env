# ── bot ──
TEMPERATURE=0
REQUEST_TIMEOUT_S=50

# ── models ──
MODEL=qwen2.5:1.5b
MODELS=qwen2.5:1.5b,bge-m3
EMBEDDING_MODEL=bge-m3

# ── search and documents ──
# Published documents folder: app/knowledge/, versioned with DVC (remote: SeaweedFS, see
# app/dvc-setup.sh). The pointer (knowledge.dvc) does go in git; the content doesn't.
KNOWLEDGE_DIR=app/knowledge
TOP_K=3
MIN_SIMILARITY=0.5
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150
MAX_FILE_KB=512
MAX_CHUNKS=2000

# ── security ──
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=30
MAX_QUESTION_CHARS=2000

# ── evaluation ──
GOLDEN_PATH=eval/golden.jsonl
EVAL_MIN_ACCURACY_ANSWERABLE=0.90
EVAL_MIN_REFUSAL_RATE=0.90
EVAL_MIN_RETRIEVAL_RECALL=0.90
# EVAL_MIN_ACCURACY=0.90
